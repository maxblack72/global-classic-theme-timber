{% extends 'base.twig' %}

{% block content %}
    {% for post in posts %}
        <article>
            <h2><a href="{{ post.link }}">{{ post.title }}</a></h2>
            <div>{{ post.excerpt }}</div>
        </article>
    {% else %}
        <p>{{ __('Nothing found.', 'global-classic-theme-timber') }}</p>
    {% endfor %}
{% endblock %}
